# GoblinSurvivor integration options for the disposable test instance.
#
# This is intentionally not a Project Zomboid Server/<name>.ini fragment:
# Build 42 ignores unknown server-option keys. Place this file at:
#   <cachedir>/Lua/goblin-bridge/config.ini
# The bridge provisioner creates this file automatically with the safe values.
# One Goblin per player. Set false to pause the companion runtime.
GoblinEnabled=true
GoblinBridgeRoot=goblin-bridge
GoblinNpcId=goblin.primary
GoblinNpcName=Goblin
GoblinNpcOutfit=Survivor
GoblinNpcOutfitId=4101
GoblinNpcVisualAsset=Goblin_Community_Human
GoblinWeapon=Base.DoubleBarrelShotgun
GoblinNpcProtected=true
GoblinCommanders=
# Follow spacing is fixed at 3 tiles by the runtime to allow chair rest.
GoblinFollowWalkDistance=2
GoblinFollowRunDistance=9
GoblinFollowHysteresis=0.5
GoblinRepathSeconds=1.25
GoblinBlockedRetrySeconds=3
GoblinRespawnSeconds=15
GoblinSpawnOffset=4
GoblinTrackerExact=true
GoblinCombatRadius=20
GoblinRangedRange=12
GoblinRangedCooldownSeconds=0.8
GoblinMeleeRange=2.25
GoblinMeleeCooldownSeconds=1
GoblinMeleePoseSeconds=0.7
GoblinMeleeImpactDelaySeconds=0.325
GoblinRecoverySeconds=0.8
GoblinStuckTimeoutSeconds=8
GoblinMaxRecoveryAttempts=3
GoblinLootRadius=8
GoblinLootScanSeconds=2
GoblinLootMaxItemsPerTask=8
GoblinAutonomyEnabled=true
GoblinAutonomyIdleSeconds=30
GoblinAutonomyDecisionSeconds=8
GoblinAutonomyExploreRadius=24
