#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    setup-steam|credentials)
        shift
        exec /usr/bin/python3 "$(dirname "$0")/setup_steam.py" "$@"
        ;;
    publish-workshop)
        shift
        exec /usr/bin/python3 "$(dirname "$0")/publish_workshop.py" "$@"
        ;;
    launch-client)
        shift
        if (( $# != 0 )); then
            printf '%s\n' 'Usage: goblin-zomboid launch-client' >&2
            exit 2
        fi
        exec "$(dirname "$0")/launch_native_client.sh"
        ;;
    *)
        printf '%s\n' \
            'Usage: goblin-zomboid setup-steam' \
            '       goblin-zomboid credentials' \
            '       goblin-zomboid publish-workshop [--visibility unlisted|public|friends|private]' \
            '       goblin-zomboid launch-client' >&2
        exit 2
        ;;
esac
