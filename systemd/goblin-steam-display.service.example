[Unit]
Description=Goblin native Steam software display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/Xorg :105 -config /etc/X11/xorg-dummy.conf -noreset -nolisten tcp -ac
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

# Install only after reviewing the display configuration. The display has no
# TCP X11 listener. Do not expose it through VNC except for a time-limited,
# password-protected interactive Steam login.
