[Unit]
Description=Goblin Project Zomboid bridge agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=goblin
Group=goblin
WorkingDirectory=/home/goblin/zomboid-goblin
Environment=GOBLIN_BRIDGE_ROOT=/mnt/goblin-zomboid
Environment=GOBLIN_ENABLED=false
# Leave this true during staging. Set false only after the server-side NPC
# contract has been verified.
Environment=GOBLIN_START_PAUSED=true
Environment=GOBLIN_PZ_HOST=192.168.0.3
Environment=GOBLIN_MEMORY_PATH=/var/lib/goblin-zomboid-agent/memory.sqlite3
# Read-only B42 map tiles copied from the current .03 server map cache.
Environment=GOBLIN_TRACKER_MAP_ROOT=/home/goblin/share/pz-map/b42/muldraugh
ExecStart=/usr/bin/python3 -m goblin_zomboid.daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/goblin-zomboid
StateDirectory=goblin-zomboid-agent
UMask=0077

[Install]
WantedBy=multi-user.target

# Install only after the bridge mount and the stage validation are complete.
# Do not enable this unit while the body feasibility gate is open.
