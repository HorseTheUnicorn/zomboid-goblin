[Unit]
Description=Goblin native Steam session
Requires=goblin-steam-display.service
After=goblin-steam-display.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=goblin
Group=goblin
WorkingDirectory=/home/goblin
Environment=HOME=/home/goblin
Environment=DISPLAY=:105
Environment=XDG_RUNTIME_DIR=/tmp/goblin-steam-runtime
Environment=SDL_AUDIODRIVER=dummy
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
Environment=__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
Environment=__GLX_VENDOR_LIBRARY_NAME=mesa
ExecStart=/usr/bin/dbus-run-session -- /home/goblin/.steam/debian-installation/steam.sh -silent -nochatui -nofriendsui -no-cef-sandbox
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target

# Enable only after the administrator has completed the native Steam login.
# Steam Guard remains a normal Steam UI interaction; no code is stored here.
