# Safe defaults; do not put secrets in this file.
GOBLIN_BRIDGE_ROOT=/mnt/goblin-zomboid
GOBLIN_ENABLED=false
GOBLIN_PZ_HOST=192.168.0.3
GOBLIN_PZ_SSH_USER=goblin
GOBLIN_PZ_BRIDGE_ROOT=/home/zomboid/Zomboid/Lua/goblin-bridge
GOBLIN_PZ_SSH_KEY=/home/goblin/.ssh/id_ed25519
GOBLIN_RELAY_INTERVAL=1
GOBLIN_RELAY_SSH_TIMEOUT=8
# Production .76 relay: remote is the PZ server. The Windows local helper
# sets this to agent so local PZ events flow to .76 and commands flow back.
GOBLIN_RELAY_REMOTE_ROLE=pz
GOBLIN_HEARTBEAT_SECONDS=5
GOBLIN_PLANNING_INTERVAL_SECONDS=60
GOBLIN_MINIMUM_BASE_GUARDS=1
GOBLIN_PZ_TIMEOUT_SECONDS=15
GOBLIN_MAX_MESSAGE_BYTES=262144
GOBLIN_QWEN_URL=http://127.0.0.1:8000
GOBLIN_QWEN_MODEL=qwen3-8b-q4km
GOBLIN_QWEN_TIMEOUT_SECONDS=20
GOBLIN_ADMIN_BIND=127.0.0.1
GOBLIN_ADMIN_PORT=8781
# Set GOBLIN_ADMIN_TOKEN through a protected service credential, not this file.
GOBLIN_TRACKER_BIND=127.0.0.1
GOBLIN_TRACKER_PORT=8782
GOBLIN_TRACKER_MAP_ROOT=/home/goblin/share/pz-map/b42/muldraugh
GOBLIN_TRACKER_ENABLED=true
GOBLIN_TRACKER_PRIVACY_MODE=exact
GOBLIN_TRACKER_SHOW_PLAYERS=true
GOBLIN_TRACKER_SHOW_PLAYER_NAMES=true
GOBLIN_TRACKER_SHOW_EXACT_POSITIONS=true
GOBLIN_TRACKER_SHOW_NPCS=true
GOBLIN_TRACKER_HISTORY_ENABLED=true
# Optional overrides; the daemon otherwise serves the repository web/ folder.
# GOBLIN_TRACKER_WEB_ROOT=/home/goblin/zomboid-goblin/web
