# Safe defaults; do not put secrets in this file.
GOBLIN_BRIDGE_ROOT=/mnt/goblin-zomboid
GOBLIN_ENABLED=false
GOBLIN_PZ_HOST=192.168.0.3
GOBLIN_PZ_SSH_USER=goblin
GOBLIN_PZ_BRIDGE_ROOT=/home/zomboid/Zomboid/Lua/goblin-bridge
GOBLIN_PZ_SSH_KEY=/home/goblin/.ssh/id_ed25519
GOBLIN_RELAY_INTERVAL=1
GOBLIN_RELAY_SSH_TIMEOUT=8
GOBLIN_HEARTBEAT_SECONDS=5
GOBLIN_PLANNING_INTERVAL_SECONDS=60
GOBLIN_PZ_TIMEOUT_SECONDS=15
GOBLIN_QWEN_URL=http://127.0.0.1:8000
GOBLIN_QWEN_MODEL=qwen3-8b-q4km
GOBLIN_ADMIN_BIND=127.0.0.1
GOBLIN_ADMIN_PORT=8781
# Set GOBLIN_ADMIN_TOKEN through a protected service credential, not this file.
