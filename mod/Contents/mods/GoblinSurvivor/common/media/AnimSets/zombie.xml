<?xml version="1.0" encoding="utf-8"?>
<!--
    Keep both the vanilla Zombie_* nodes and the player-avatar Bob_* nodes
    available to the Goblin's IsoZombie anim set.  The Goblin-specific nodes
    below are selected by the GoblinNPC/GoblinMoveType variables written by
    GoblinBody.lua; ordinary zombies continue to resolve their vanilla nodes.
-->
<animSet>
    <animNodeFilter>
        <folderPrefixes>Bob</folderPrefixes>
        <namePrefixes>Bob_</namePrefixes>
        <folderPrefixes>Zombie</folderPrefixes>
        <namePrefixes>Zombie_</namePrefixes>
    </animNodeFilter>
</animSet>
